#!/command/with-contenv bashio
# ==============================================================================
# Home Assistant Community App: Spotify Connect
# Runs librespot
# ==============================================================================
declare -a options
declare bitrate
declare name
declare autoplay
declare initial_volume
declare backend
declare fifo_path

bashio::log.info 'Starting librespot...'

# Bitrate
options+=(--bitrate $(bashio::config 'bitrate'))

# Initial Volume
initial_volume=$(bashio::config 'initial_volume')
options+=(--initial-volume "$initial_volume")

# Device name
name=$(bashio::config 'name')
options+=(--name "${name}")

# Autoplay
if bashio::config.true 'autoplay'; then
  options+=(--autoplay on)
fi

# Save writes
options+=(--disable-audio-cache)

# backend
backend=$(bashio::config 'backend')
fifo_path=$(bashio::config 'fifo_path')

if [[ "${backend}" == "pipe" ]]; then
  options+=(--backend pipe)
  options+=(--device "$fifo_path")
elif [[ "${backend}" == "pulseaudio" ]]; then
  options+=(--backend pulseaudio)

# Are we running in debug mode?
if bashio::debug; then
  options+=(--verbose)
fi

# Run librespot
exec librespot "${options[@]}"
